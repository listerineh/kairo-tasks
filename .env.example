# Supabase project URL and public anon key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Logger service shared key (used by the app and the Supabase Edge Function)
LOGS_API_KEY=your_logs_api_key_here

# Google OAuth client IDs (from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# iOS native configuration
# The reversed Google client ID must also be added to ios/Flutter/Env.xcconfig:
# REVERSED_GOOGLE_CLIENT_ID=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
# You can generate it from GOOGLE_IOS_CLIENT_ID:
# com.googleusercontent.apps.<GOOGLE_IOS_CLIENT_ID without .apps.googleusercontent.com>
